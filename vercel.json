{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm run install:all",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
